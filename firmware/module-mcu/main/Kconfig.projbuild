menu "KkotKkot UWB (DW3000 계열)"

    # 기본값은 ESP32-S3 SPI2(FSPI) IOMUX 핀. 스트래핑 핀(GPIO0, 3, 45, 46)은 쓰지 않는다.

    config KKOT_UWB_PIN_SCLK
        int "SPI SCLK GPIO"
        default 12

    config KKOT_UWB_PIN_MOSI
        int "SPI MOSI GPIO"
        default 11

    config KKOT_UWB_PIN_MISO
        int "SPI MISO GPIO"
        default 13

    config KKOT_UWB_PIN_CS
        int "SPI CS GPIO"
        default 10

    config KKOT_UWB_PIN_RST
        int "칩 RSTn GPIO (-1이면 사용 안 함, 오픈 드레인으로만 구동)"
        default 9

    config KKOT_UWB_SPI_SLOW_HZ
        int "초기(PLL 잠금 전) SPI 클럭 Hz"
        default 2000000
        range 100000 7000000

    config KKOT_UWB_PROBE_RETRY_MS
        int "칩을 못 찾았을 때 재시도 간격(ms)"
        default 2000

endmenu
